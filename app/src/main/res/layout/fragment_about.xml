<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">
    <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
        <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
            <TextView
    android:id="@+id/aboutTitle"
    style="@style/QuietTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_aboutTitle" />
            <TextView
    android:id="@+id/brandHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_brandHeading" />
            <TextView
    android:id="@+id/brandBody"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_brandBody" />
            <TextView
    android:id="@+id/howHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_howHeading" />
            <TextView
    android:id="@+id/howBody"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_howBody" />
            <TextView
    android:id="@+id/stepsHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_stepsHeading" />
            <TextView
    android:id="@+id/stepsBody"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_stepsBody" />
            <TextView
    android:id="@+id/cycleHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_cycleHeading" />
            <TextView
    android:id="@+id/cycleBody"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_cycleBody" />
            <TextView
    android:id="@+id/intervalHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_intervalHeading" />
            <TextView
    android:id="@+id/intervalBody"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_intervalBody" />
            <TextView
    android:id="@+id/privacyHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_privacyHeading" />
            <TextView
    android:id="@+id/privacyBody"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_privacyBody" />
            <TextView
    android:id="@+id/noteHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_noteHeading" />
            <TextView
    android:id="@+id/noteBody"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_noteBody" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
<TextView android:id="@+id/aboutVersion" style="@style/QuietBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp"/></LinearLayout>
