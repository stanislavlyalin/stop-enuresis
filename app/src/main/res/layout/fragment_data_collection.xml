<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/collectData" android:id="@+id/tvDataCollectionTitle" style="@style/QuietTitle" android:layout_weight="1" />
        <ImageButton android:id="@+id/btnClearPendingSamples" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_more" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/clearPendingSamples" app:tint="@color/ui_secondary" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Запись" android:id="@+id/recordingStatus" android:textSize="12sp" android:textColor="@color/ui_secondary" android:visibility="gone" style="@style/QuietBody" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="0dp" android:layout_marginBottom="8dp" />
    <com.github.mikephil.charting.charts.LineChart android:id="@+id/lineChartAmplitude" android:layout_width="match_parent" android:layout_height="112dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/volumeThreshold" android:textStyle="bold" android:id="@+id/tvThresholdLabel" style="@style/QuietBody" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="75" android:textStyle="bold" android:textSize="16sp" android:id="@+id/tvThresholdValue" android:gravity="end" style="@style/QuietBody" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
        <com.google.android.material.slider.Slider android:id="@+id/seekBarThreshold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:valueFrom="0" android:valueTo="200" android:stepSize="1" app:trackHeight="6dp" app:thumbRadius="10dp" app:thumbWidth="20dp" app:thumbHeight="20dp" app:thumbTrackGapSize="0dp" app:thumbColor="@color/brand_surface" app:thumbStrokeColor="@color/brand_orange" app:thumbStrokeWidth="2dp" app:trackColorActive="@color/brand_orange" app:trackColorInactive="@color/ui_slider_track" app:tickVisible="false" app:trackStopIndicatorSize="0dp" app:labelBehavior="gone" android:contentDescription="@string/volumeThreshold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="0dp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:id="@+id/tvRustlingCounter" android:textSize="14sp" style="@style/QuietBody" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text=" · " android:gravity="center" style="@style/QuietBody" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:id="@+id/tvSilenceCounter" android:textSize="14sp" style="@style/QuietBody" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text=" · " android:gravity="center" style="@style/QuietBody" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:id="@+id/tvRemainingCounter" android:textSize="14sp" style="@style/QuietBody" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAudioFragments" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" />
    <Button android:id="@+id/btnRecordToggle" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/startRecording" />
</LinearLayout>
