<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp" android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/onboarding_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboardingSkip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/onboardingSkip"
            android:textAllCaps="false"
            android:textColor="@color/onboarding_body" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboardingPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="12dp" android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/onboardingDots"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboardingNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_orange"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="2"
            android:minHeight="56dp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:singleLine="false"
            android:text="@string/onboardingNext"
            android:textAllCaps="false"
            android:textColor="@color/brand_on_orange"
            android:textSize="16sp"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
