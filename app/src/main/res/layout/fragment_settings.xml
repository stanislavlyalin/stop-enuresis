<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Настройки" android:id="@+id/tvSettingsTitle" style="@style/QuietTitle" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Оформление" style="@style/QuietHeading" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Тема" android:textStyle="bold" style="@style/QuietBody" android:layout_marginEnd="12dp" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/themeChoice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/themeSystem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="Системная" android:textSize="12sp" android:textColor="@color/quiet_choice_text" app:backgroundTint="@color/quiet_choice_fill" app:strokeColor="@color/ui_divider" app:cornerRadius="10dp" style="?attr/materialButtonOutlinedStyle" />
                <com.google.android.material.button.MaterialButton android:id="@+id/themeLight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="Светлая" android:textSize="12sp" android:textColor="@color/quiet_choice_text" app:backgroundTint="@color/quiet_choice_fill" app:strokeColor="@color/ui_divider" app:cornerRadius="10dp" style="?attr/materialButtonOutlinedStyle" />
                <com.google.android.material.button.MaterialButton android:id="@+id/themeDark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="2dp" android:text="Тёмная" android:textSize="12sp" android:textColor="@color/quiet_choice_text" app:backgroundTint="@color/quiet_choice_fill" app:strokeColor="@color/ui_divider" app:cornerRadius="10dp" style="?attr/materialButtonOutlinedStyle" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ночное прослушивание" style="@style/QuietHeading" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Защитный интервал" android:textStyle="bold" style="@style/QuietBody" android:layout_weight="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 час" android:id="@+id/tvCooldownValue" android:textStyle="bold" android:textSize="16sp" android:gravity="end" style="@style/QuietBody" />
        </LinearLayout>
        <com.google.android.material.slider.Slider android:id="@+id/seekBarCooldown" android:layout_width="match_parent" android:layout_height="48dp" android:valueFrom="0" android:valueTo="5" android:stepSize="1" app:trackHeight="4dp" app:thumbRadius="7dp" app:thumbWidth="14dp" app:thumbHeight="14dp" app:thumbTrackGapSize="0dp" app:thumbColor="@color/brand_orange" app:tickColorActive="@color/brand_orange" app:tickColorInactive="@color/ui_slider_track" app:tickRadiusActive="5dp" app:tickRadiusInactive="5dp" app:trackColorActive="@color/brand_orange" app:trackColorInactive="@color/ui_slider_track" app:labelBehavior="gone" android:contentDescription="Защитный интервал" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="30 мин - 3 ч · шаг 30 мин" android:textSize="12sp" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Эпизоды ёрзания" style="@style/QuietBody" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="От 1 до 12" android:textSize="12sp" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_quiet_outline">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/episodesMinus" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="−" android:textSize="24sp" android:textColor="@color/ui_secondary" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Уменьшить: эпизоды ёрзания" />
                <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:text="3" android:id="@+id/tvAlarmRustlingEpisodesValue" android:gravity="center" android:textStyle="bold" android:textSize="16sp" style="@style/QuietBody" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/episodesPlus" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="+" android:textSize="24sp" android:textColor="@color/ui_secondary" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Увеличить: эпизоды ёрзания" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Период подтверждения" style="@style/QuietBody" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="От 1 до 10 мин" android:textSize="12sp" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_quiet_outline">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/periodMinus" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="−" android:textSize="24sp" android:textColor="@color/ui_secondary" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Уменьшить: период подтверждения" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 мин" android:id="@+id/tvConfirmationPeriodValue" android:minWidth="44dp" android:paddingHorizontal="2dp" android:singleLine="true" android:gravity="center" android:textStyle="bold" android:textSize="16sp" style="@style/QuietBody" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/periodPlus" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="+" android:textSize="24sp" android:textColor="@color/ui_secondary" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Увеличить: период подтверждения" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Модель" style="@style/QuietHeading" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnImportModel" android:minHeight="56dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_model_import" android:importantForAccessibility="no" app:tint="@color/ui_secondary" android:layout_marginEnd="16dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Импорт модели" android:textSize="16sp" android:textStyle="bold" style="@style/QuietBody" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Файл JSON" android:textSize="12sp" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no" app:tint="@color/ui_secondary" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/btnExportModel" android:minHeight="56dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_model_export" android:importantForAccessibility="no" app:tint="@color/ui_secondary" android:layout_marginEnd="16dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Экспорт модели" android:textSize="16sp" android:textStyle="bold" style="@style/QuietBody" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Файл JSON" android:textSize="12sp" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no" app:tint="@color/ui_secondary" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/tvAppVersion" android:textSize="12sp" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
    </LinearLayout>
</ScrollView>
