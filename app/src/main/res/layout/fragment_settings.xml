<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ui.settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/themeChoice" android:layout_width="match_parent" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true">
<com.google.android.material.button.MaterialButton android:id="@+id/themeSystem" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Системная" android:textSize="12sp" android:paddingHorizontal="4dp"/><com.google.android.material.button.MaterialButton android:id="@+id/themeLight" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Светлая" android:textSize="12sp" android:paddingHorizontal="4dp"/><com.google.android.material.button.MaterialButton android:id="@+id/themeDark" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Тёмная" android:textSize="12sp" android:paddingHorizontal="4dp"/></com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView
            android:id="@+id/tvCooldownLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/protectionIntervalTitle"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:id="@+id/layoutCooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekBarCooldown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="5"
                android:progress="1" />

            <TextView
                android:id="@+id/tvCooldownValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="60 мин"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/protectionIntervalDescription"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/tvAlarmRustlingEpisodesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alarmRustlingEpisodes"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:id="@+id/layoutAlarmRustlingEpisodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button android:id="@+id/episodesMinus" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:contentDescription="Уменьшить" android:padding="0dp"/><Button android:id="@+id/episodesPlus" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:contentDescription="Увеличить" android:padding="0dp"/>

            <TextView
                android:id="@+id/tvAlarmRustlingEpisodesValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="3"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/confirmationPeriod"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button android:id="@+id/periodMinus" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:contentDescription="Уменьшить" android:padding="0dp"/><Button android:id="@+id/periodPlus" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:contentDescription="Увеличить" android:padding="0dp"/>

            <TextView
                android:id="@+id/tvConfirmationPeriodValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="2 мин"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutModelTransfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportModel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/exportModel" />

            <Button
                android:id="@+id/btnImportModel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/importModel" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Версия: 41b0932" />

    </LinearLayout>
</ScrollView>
