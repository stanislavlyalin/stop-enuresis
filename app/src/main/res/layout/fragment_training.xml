<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">
    <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"><TextView
    android:id="@+id/trainingTitle"
    style="@style/QuietTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_trainingTitle" />
    <ImageButton
    android:id="@+id/btnClearTrainingDataset"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_gravity="end"
    android:src="@drawable/ic_more"
    app:tint="@color/ui_text"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/clearTrainingDataset" />
    </FrameLayout><androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
        <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
            <ImageView
    android:id="@+id/trainingIllustration"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_marginTop="24dp"
    android:src="@drawable/training_model"
    android:scaleType="fitCenter"
    android:importantForAccessibility="no" />
            <TextView
    android:id="@+id/tvTrainingStatusCircle"
    style="@style/QuietTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_tvTrainingStatusCircle"
    android:gravity="center" />
            <TextView
    android:id="@+id/trainingMetrics"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_trainingMetrics"
    android:gravity="center" />
            <TextView
    android:id="@+id/datasetHeading"
    style="@style/QuietHeading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_datasetHeading" />
            <TextView
    android:id="@+id/tvTrainingDatasetStats"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_tvTrainingDatasetStats" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
        <Button
    android:id="@+id/btnStartTraining"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:text="@string/quiet_btnStartTraining" />
        <LinearLayout
    android:id="@+id/layoutTrainingProgress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
            <ProgressBar
    android:id="@+id/progressTrainingFiles"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="24dp" />
            <TextView
    android:id="@+id/tvTrainingProgress"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_tvTrainingProgress" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
