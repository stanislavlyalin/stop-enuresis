<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/usageTitle" style="@style/QuietTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quiet_usageTitle" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/sleepIllustration" android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="8dp" android:src="@drawable/usage_sleep" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tvUsageStatusCircle" style="@style/QuietTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quiet_tvUsageStatusCircle" android:gravity="center" android:textSize="26sp" />
            <TextView android:id="@+id/usageMicrophone" style="@style/QuietBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quiet_usageMicrophone" android:gravity="center" android:textSize="18sp" android:textColor="@color/ui_secondary" />
            <LinearLayout android:id="@+id/layoutRustlingDetections" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" android:orientation="horizontal" />
            <TextView android:id="@+id/tvNextAlarmAllowed" style="@style/QuietBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quiet_tvNextAlarmAllowed" android:gravity="center" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_database" android:importantForAccessibility="no" app:tint="@color/ui_secondary" android:layout_marginEnd="12dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quiet_save_fragments" android:textSize="16sp" style="@style/QuietBody" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quiet_save_hint" android:textSize="12sp" android:textColor="@color/ui_secondary" style="@style/QuietBody" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cbSaveSamples" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:textSize="14sp" android:contentDescription="@string/quiet_save_fragments" app:thumbTint="@color/quiet_switch_thumb" app:trackTint="@color/quiet_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <Button android:id="@+id/btnUsageMain" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/quiet_btnUsageMain" />
</LinearLayout>
