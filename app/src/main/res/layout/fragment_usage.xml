<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">
    <TextView
    android:id="@+id/usageTitle"
    style="@style/QuietTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_usageTitle" />
    <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
        <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
            <ImageView
    android:id="@+id/sleepIllustration"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginTop="24dp"
    android:src="@drawable/usage_sleep"
    android:scaleType="fitCenter"
    android:importantForAccessibility="no" />
            <TextView
    android:id="@+id/tvUsageStatusCircle"
    style="@style/QuietTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_tvUsageStatusCircle"
    android:gravity="center" />
            <TextView
    android:id="@+id/usageMicrophone"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_usageMicrophone"
    android:gravity="center" />
            <LinearLayout
    android:id="@+id/layoutRustlingDetections"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center"
    android:orientation="horizontal" />
            <TextView
    android:id="@+id/tvNextAlarmAllowed"
    style="@style/QuietBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quiet_tvNextAlarmAllowed"
    android:gravity="center" />
            <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/cbSaveSamples"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:text="@string/quiet_save_fragments" android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
    android:id="@+id/btnUsageMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:text="@string/quiet_btnUsageMain" />
</LinearLayout>
