<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ui.UsageFragment">

    <TextView
        android:id="@+id/tvUsageStatusCircle"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_training_status_circle"
        android:gravity="center"
        android:text="@string/usageHello"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        app:layout_constraintBottom_toTopOf="@id/layoutRustlingDetections"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <LinearLayout
        android:id="@+id/layoutRustlingDetections"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tvNextAlarmAllowed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUsageStatusCircle"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvNextAlarmAllowed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutUsageActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRustlingDetections"
        tools:text="Пауза до 07:30"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/layoutUsageActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnUsageMain"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/startListening" />

        <CheckBox
            android:id="@+id/cbSaveSamples"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/brand_orange"
            android:checked="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/saveUsageSamples"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:checked="true" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
