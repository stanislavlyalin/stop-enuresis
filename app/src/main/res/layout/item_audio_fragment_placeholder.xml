<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/sampleDate" android:textSize="16sp" android:textStyle="bold" android:paddingTop="4dp" android:paddingBottom="8dp" style="@style/QuietBody" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp" android:paddingEnd="12dp">
        <ImageButton android:id="@+id/btnPlay" android:layout_width="48dp" android:layout_height="48dp" android:padding="15dp" android:scaleType="fitCenter" android:background="@drawable/bg_sample_play" android:src="@drawable/ic_nav_play" android:contentDescription="@string/playAudioFragment" app:tint="@color/brand_on_orange" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:id="@+id/tvAudioFragmentFileName" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" style="@style/QuietBody" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:id="@+id/tvAudioFragmentAverageAmplitude" android:textSize="12sp" android:textColor="@color/ui_secondary" android:gravity="end" style="@style/QuietBody" />
            </LinearLayout>
            <com.stanislavlyalin.stopenuresis.ui.WaveformView android:id="@+id/waveformAudioFragment" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="2dp" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnReject" android:layout_width="60dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="Тишина" android:textSize="12sp" android:textAllCaps="false" android:textStyle="normal" android:textColor="@color/ui_text" android:background="?attr/selectableItemBackgroundBorderless" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAccept" android:layout_width="60dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="Ёрзает" android:textSize="12sp" android:textAllCaps="false" android:textStyle="normal" android:textColor="@color/ui_text" android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/btnDelete" android:layout_width="36dp" android:layout_height="48dp" android:paddingHorizontal="6dp" android:paddingVertical="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more" android:contentDescription="Действия с записью" app:tint="@color/ui_secondary" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ui_divider" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" />
</LinearLayout>
