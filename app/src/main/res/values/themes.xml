<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.StopEnuresis" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/brand_on_orange</item>
        <item name="colorPrimaryContainer">@color/brand_orange_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_orange</item>
        <item name="colorSecondary">@color/brand_orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="android:textColorPrimary">@color/ui_text</item>
        <item name="android:textColorSecondary">@color/ui_secondary</item>
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.StopEnuresis.Alarm" parent="Theme.StopEnuresis">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/alarm_background</item>
        <item name="android:navigationBarColor">@color/alarm_background</item>
    </style>

    <style name="BottomNavigationItemText">
        <item name="android:ellipsize">none</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lines">2</item>
        <item name="android:maxLines">2</item>
        <item name="android:singleLine">false</item>
        <item name="android:textSize">11sp</item>
    </style>

</resources>
